# Core services
NODE_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_URL=postgres://famax:famax-local@localhost:5432/famax_mes
DB_POOL_SIZE=10
PORT=4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://localhost:3004

# Better Auth (use a unique, long random value outside local development)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_TRUSTED_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004

# GrowthBook (FLAGS_JSON remains available if remote flags are unavailable)
GROWTHBOOK_API_HOST=https://cdn.growthbook.io
GROWTHBOOK_CLIENT_KEY=
FLAGS_JSON={}

# Resend + React Email
RESEND_API_KEY=
EMAIL_FROM=FAMAX MES <notifications@your-verified-domain.example>

# Rootprint observability
ROOTPRINT_INGEST_URL=
ROOTPRINT_TOKEN=

# OpenRouter via the Vercel AI SDK
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# WhatsApp Cloud API (messages require explicit recipient opt-in)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
